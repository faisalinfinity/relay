# Copy to .env to override. Every value below is also the default used in development.

DATABASE_URL=postgres://relay:relay@localhost:5433/relay
TEST_DATABASE_URL=postgres://relay:relay@localhost:5433/relay_test
PORT=4000

# Shared secret between the website form backend and Relay's intake webhook
WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# How old a signed request may be before it is rejected (replay window)
WEBHOOK_TOLERANCE_SECONDS=300

# Suggested replies. Embeddings always run on Ollama (local, no key).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Optional: set a key to draft replies with Claude instead of the local model
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Chunks less similar than this to the ticket don't count as covering it (see README)
SUGGESTION_MIN_SIMILARITY=0.65
HELP_CENTER_URL=https://help.slotwise.example/articles
