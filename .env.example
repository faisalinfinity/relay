# Copy to .env to override. Every value below is also the default used in development.

DATABASE_URL=postgres://relay:relay@localhost:5433/relay
TEST_DATABASE_URL=postgres://relay:relay@localhost:5433/relay_test
PORT=4000

# Shared secret between the website form backend and Relay's intake webhook
WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# How old a signed request may be before it is rejected (replay window)
WEBHOOK_TOLERANCE_SECONDS=300
