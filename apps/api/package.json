    "send:ticket": "tsx scripts/send-test-ticket.ts"
  },
  "dependencies": {
    "@relay/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
